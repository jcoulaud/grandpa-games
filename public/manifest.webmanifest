{
  "name": "Jeux",
  "short_name": "Jeux",
  "description": "Des jeux simples pour les grands-parents. Gratuit, sans publicité, sans compte.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "related_applications": [{ "platform": "webapp", "url": "https://jeux-papi.fr/manifest.webmanifest" }],
  "background_color": "#0F4F47",
  "theme_color": "#0F4F47",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
